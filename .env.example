# ============================================================================
# MindKatha Clinical Practice — WhatsApp & SMS OTP Gateway Configuration (.env)
# Copy this file to `.env` in `mindkatha-ng/.env` and fill in ONE provider below.
# When no provider key is set, the server automatically runs in `sandbox` mode.
# ============================================================================

# Server & Security Settings
OTP_SERVER_PORT=3001
ALLOWED_ORIGIN=http://localhost:4200
PRACTICE_WHATSAPP_NUMBER=919876543210
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HMAC_SECRET=

# Active Provider: 'auto' | 'msg91' | 'meta_whatsapp' | 'twilio' | 'gupshup' | 'sandbox'
OTP_PROVIDER=auto

# ----------------------------------------------------------------------------
# OPTION 1 (Recommended for India +91): MSG91 WhatsApp / SMS OTP Gateway
# Dashboard: https://control.msg91.com/
# ----------------------------------------------------------------------------
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ----------------------------------------------------------------------------
# OPTION 2 (Official Meta Cloud API — 1,000 Free Service Conversations/Month)
# Dashboard: https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
# ----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=mindkatha_otp_verify
WHATSAPP_OTP_TEMPLATE_LANG=en

# ----------------------------------------------------------------------------
# OPTION 3: Twilio Verify (WhatsApp & SMS)
# Dashboard: https://console.twilio.com/us1/develop/verify/services
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
TWILIO_CHANNEL=whatsapp

# ----------------------------------------------------------------------------
# OPTION 4: Gupshup WhatsApp Enterprise
# Dashboard: https://www.gupshup.io/whatsapp-api
# ----------------------------------------------------------------------------
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=MindKatha
GUPSHUP_SOURCE_NUMBER=919876543210
GUPSHUP_TEMPLATE_ID=
